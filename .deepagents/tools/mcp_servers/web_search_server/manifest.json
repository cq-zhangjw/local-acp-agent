        "properties": {
          "query": {
            "type": "string",
            "description": "search keywords, e.g. \"2026年最新 AI Agent 框架对比\""
          },
          "engine": {
            "default": "bing",
            "type": "string",
            "description": "\"bing\" (default, cn.bing.com) or \"baidu\""
          },
          "max_results": {
            "default": 8,
            "type": "integer",
            "description": "number of results to return (default 8, max 15)"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "execution": null,
      "outputSchema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
